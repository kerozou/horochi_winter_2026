{
  "name": "hororocket",
  "version": "2.1.0",
  "description": "2D Rocket Launch Game with Phaser.js",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "npx http-server -p 8000 -c-1",
    "dev": "npx http-server -p 8000 -c-1 -o",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:prepare": "node scripts/prepare-tauri-dist.cjs",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg",
    "dist:linux": "tauri build --bundles appimage",
    "postinstall": "node scripts/copy-phaser.cjs",
    "vendor:phaser": "node scripts/copy-phaser.cjs"
  },
  "keywords": [
    "phaser",
    "game",
    "rocket",
    "physics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "phaser": "^3.80.1",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0"
  }
}
