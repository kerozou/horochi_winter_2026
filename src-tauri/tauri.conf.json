{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ほろっちの冬休み",
  "version": "2.1.0",
  "identifier": "com.hororocket.horochi-winter",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://127.0.0.1:8000",
    "beforeBuildCommand": "npm run tauri:prepare",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "ほろっちの冬休み",
        "width": 1280,
        "height": 880,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "2D Rocket Launch Game with Phaser.js",
    "longDescription": "2D Rocket Launch Game with Phaser.js"
  }
}
